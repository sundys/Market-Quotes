APP_ENV=production

CACHE_TTL=60

# 美股指数（东方财富）
YF_MIN_INTERVAL=45
YF_MAX_RETRIES=3
YF_BACKOFF_BASE=5
YF_BACKOFF_MAX=120

# COMEX 期金（新浪外盘）与上海黄金交易所
GC_REFRESH_INTERVAL=30
SGE_REFRESH_INTERVAL=30

# 休市降频间隔
CLOSED_MARKET_INTERVAL=300

# 单次抓取超时（会被自动压到小于采集间隔）、间隔抖动比例
FETCH_TIMEOUT=10
FETCH_JITTER=0.1

# SGE 日线缓存 TTL（涨跌基准/月线/详情历史共用一次请求）
SGE_HIST_TTL=3600
SPARKLINE_REFRESH_INTERVAL=3600

# 磁盘快照最小写盘间隔；AKShare 内部请求的兜底 socket 超时
DISK_SAVE_MIN_INTERVAL=5
SOCKET_TIMEOUT=15

API_TIMEOUT=15

# 测试用：强制所有数据源失败，用于验证退避/冷却/降级（仅测试环境开启）
# YF_FORCE_429=1
